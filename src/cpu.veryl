module cpu (
    clk   : input   clock                  ,
    rst   : input   reset                  ,
    cpubus: modport bus_if::<8, 16>::master,
) {
    // CPU Registers
    var reg_a : logic<8> ; // Accumulator
    var reg_x : logic<8> ; // X register
    var reg_y : logic<8> ; // Y register
    var reg_sp: logic<8> ; // Stack pointer
    var reg_pc: logic<16>; // Program counter
    var reg_p : logic<8> ; // Status Register

    enum opcode_t: logic<8> {
        SEI = 8'h78,
        TXS = 8'h9A,
        INX = 8'hE8,
        DEY = 8'h88,
        LDA_IMM = 8'hA9,
        LDA_ABX = 8'hBD,
        LDX_IMM = 8'hA2,
        LDY_IMM = 8'hA0,
        STA_ABS = 8'h8D,
        BNE = 8'hD0,
        JMP_ABS = 8'h4C,
    }
    var opcode: logic<8>;
    var op1   : logic<8>;

    enum cpu_state_t {
        RESET0,
        RESET1,
        RESET2,
        FETCH,
        DECODE,
        OP1,
        OP2,
        EXEC,
    }
    var state: cpu_state_t;
    always_comb {
        cpubus.addr  = 0;
        cpubus.wen   = 0;
        cpubus.wdata = 0;
        case (state) {
            cpu_state_t::RESET0: {
                cpubus.addr = 16'hFFFC;
            }
            cpu_state_t::RESET1: {
                cpubus.addr = 16'hFFFD;
            }
            cpu_state_t::FETCH: {
                cpubus.addr = reg_pc;
            }
            cpu_state_t::DECODE: {
                case (cpubus.rdata) {
                    opcode_t::LDX_IMM: {
                        cpubus.addr = reg_pc + 1;
                    }
                    opcode_t::LDA_IMM: {
                        cpubus.addr = reg_pc + 1;
                    }
                    opcode_t::LDY_IMM: {
                        cpubus.addr = reg_pc + 1;
                    }
                    opcode_t::STA_ABS: {
                        cpubus.addr = reg_pc + 1;
                    }
                    default: {
                        cpubus.addr = 0;
                    }
                }
            }
            cpu_state_t::OP1: {
                if opcode == opcode_t::STA_ABS {
                    cpubus.addr = reg_pc + 2;
                }
            }
            cpu_state_t::OP2: {
                if opcode == opcode_t::STA_ABS {
                    cpubus.addr  = {cpubus.rdata, op1};
                    cpubus.wdata = reg_a;
                    cpubus.wen   = 1'b1;
                }
            }
            default: {
                cpubus.addr = 0;
            }
        }
    }
    always_ff {
        if_reset {
            state  = cpu_state_t::RESET0;
            reg_pc = 0;
            reg_p  = 'h24;
        } else {
            case (state) {
                cpu_state_t::RESET0: {
                    state = cpu_state_t::RESET1;
                }
                cpu_state_t::RESET1: {
                    reg_pc[7:0] = cpubus.rdata;
                    state       = cpu_state_t::RESET2;
                }
                cpu_state_t::RESET2: {
                    reg_pc[15:8] = cpubus.rdata;
                    state        = cpu_state_t::FETCH;
                }
                cpu_state_t::FETCH: {
                    state = cpu_state_t::DECODE;
                }
                cpu_state_t::DECODE: {
                    case (cpubus.rdata) {
                        opcode_t::SEI: {
                            $display("[DECODE] PC=%04h OPCODE=SEI", reg_pc);
                            reg_p[2] = 1'b1;
                            state    = cpu_state_t::FETCH;
                            reg_pc   = reg_pc + 1;
                        }
                        opcode_t::TXS: {
                            $display("[DECODE] PC=%04h OPCODE=TXS", reg_pc);
                            reg_sp = reg_x;
                            reg_pc = reg_pc + 1;
                            state  = cpu_state_t::FETCH;
                        }
                        opcode_t::INX: {
                            let result: logic<8> = reg_x + 1;
                            $display("[DECODE] PC=%04h OPCODE=INX", reg_pc);
                            reg_x    = result;
                            reg_p[1] = (result == 0);
                            reg_p[7] = result[7];
                            state    = cpu_state_t::FETCH;
                            reg_pc   = reg_pc + 1;
                        }
                        opcode_t::DEY: {
                            let result: logic<8> = reg_y - 1;
                            $display("[DECODE] PC=%04h OPCODE=DEY", reg_pc);
                            reg_y    = result;
                            reg_p[1] = (result == 0);
                            reg_p[7] = result[7];
                            state    = cpu_state_t::FETCH;
                            reg_pc   = reg_pc + 1;
                        }
                        opcode_t::LDX_IMM: {
                            $display("[DECODE] PC=%04h OPCODE=LDX_IMM", reg_pc);
                            opcode = cpubus.rdata;
                            state  = cpu_state_t::OP1;
                        }
                        opcode_t::LDA_IMM: {
                            $display("[DECODE] PC=%04h OPCODE=LDA_IMM", reg_pc);
                            opcode = cpubus.rdata;
                            state  = cpu_state_t::OP1;
                        }
                        opcode_t::LDY_IMM: {
                            $display("[DECODE] PC=%04h OPCODE=LDY_IMM", reg_pc);
                            opcode = cpubus.rdata;
                            state  = cpu_state_t::OP1;
                        }
                        opcode_t::STA_ABS: {
                            $display("[DECODE] PC=%04h OPCODE=STA_ABS", reg_pc);
                            opcode = cpubus.rdata;
                            state  = cpu_state_t::OP1;
                        }
                        default: {
                            $display("[DECODE] Unknown Opcode : PC=%04h OPCODE=%02h", reg_pc, cpubus.rdata);
                        }
                    }
                }
                cpu_state_t::OP1: {
                    case (opcode) {
                        opcode_t::LDX_IMM: {
                            reg_x    = cpubus.rdata;
                            reg_p[1] = (cpubus.rdata == 0);
                            reg_p[7] = cpubus.rdata[7];
                            reg_pc   = reg_pc + 2;
                            state    = cpu_state_t::FETCH;
                        }
                        opcode_t::LDA_IMM: {
                            reg_a    = cpubus.rdata;
                            reg_p[1] = (cpubus.rdata == 0);
                            reg_p[7] = cpubus.rdata[7];
                            reg_pc   = reg_pc + 2;
                            state    = cpu_state_t::FETCH;
                        }
                        opcode_t::LDY_IMM: {
                            reg_y    = cpubus.rdata;
                            reg_p[1] = (cpubus.rdata == 0);
                            reg_p[7] = cpubus.rdata[7];
                            reg_pc   = reg_pc + 2;
                            state    = cpu_state_t::FETCH;
                        }
                        opcode_t::STA_ABS: {
                            op1   = cpubus.rdata;
                            state = cpu_state_t::OP2;
                        }
                    }
                }
                cpu_state_t::OP2: {
                    case (opcode) {
                        opcode_t::STA_ABS: {
                            reg_pc = reg_pc + 3;
                            state  = cpu_state_t::FETCH;
                        }
                    }
                }
            }
        }
    }
}
